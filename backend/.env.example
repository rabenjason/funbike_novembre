# Connect to an existing MySQL/MariaDB database. No Docker required.
# URL-encode reserved characters in DB_USER or DB_PASSWORD.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/funbike

API_PORT=4000
API_PROXY_TARGET=http://127.0.0.1:4000
# Persistent, writable directory for imported catalog photos (relative to backend/ by default).
UPLOAD_DIR=uploads

# Generate a private random secret (at least 32 bytes); never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Set locally only for `npm run admin:create`; remove INITIAL_ADMIN_PASSWORD afterwards.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
